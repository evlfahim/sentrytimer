{
  "name": "sentrytimer",
  "version": "1.0.0",
  "description": "A modular, local-first time tracker that auto-detects git repositories, logs sessions with branch context, and generates weekly reports.",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/plugin"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
