{
  "name": "sentry-timer",
  "displayName": "SentryTimer",
  "description": "A local-first time tracker that auto-detects git repositories, logs sessions with branch context, and generates weekly reports.",
  "version": "1.0.0",
  "publisher": "sentry-timer",
  "repository": {
    "type": "git",
    "url": "https://github.com/sentry-timer/sentrytimer"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "time-tracking",
    "git",
    "timer",
    "productivity"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sentry-timer.start",
        "title": "SentryTimer: Start Session",
        "icon": "$(play)"
      },
      {
        "command": "sentry-timer.stop",
        "title": "SentryTimer: Stop Session",
        "icon": "$(stop)"
      },
      {
        "command": "sentry-timer.report",
        "title": "SentryTimer: Generate Weekly Report",
        "icon": "$(report)"
      },
      {
        "command": "sentry-timer.delete",
        "title": "SentryTimer: Delete Session",
        "icon": "$(trash)"
      },
      {
        "command": "sentry-timer.list",
        "title": "SentryTimer: List Sessions",
        "icon": "$(list-unordered)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sentry-timer.start",
          "when": "true"
        },
        {
          "command": "sentry-timer.stop",
          "when": "true"
        },
        {
          "command": "sentry-timer.report",
          "when": "true"
        },
        {
          "command": "sentry-timer.delete",
          "when": "true"
        },
        {
          "command": "sentry-timer.list",
          "when": "true"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest --ci --runInBand --forceExit",
    "vsce-package": "vsce package",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@sentry-timer/core": "1.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.84.0",
    "@types/jest": "^29.5.12",
    "@vscode/vsce": "^2.22.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
